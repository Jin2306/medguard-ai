# Copy to .env and fill these in when you have credentials.
# Leave them empty to run in explicitly labeled DEMO MODE / local fallback.
# MedGuard never invents a model id or an API host.

# Full chat-completions URL from your Meta API credentials.
# The client POSTs to this value exactly as written. It does not append a path.
# Example shape (do not use unless it is the URL you were issued):
# META_BASE_URL=https://api.llama.com/v1/chat/completions
META_BASE_URL=
META_MODEL=
META_API_KEY=
# Optional. Defaults to Bearer.
META_AUTH_SCHEME=Bearer

# MongoDB Atlas connection string. If this is empty, runs are stored locally
# and labeled as a local fallback — they are not written to Atlas.
MONGODB_URI=
MONGODB_DB=medguard

# Optional Atlas Vector Search. Both values are required before MedGuard attempts it.
# Leave them empty to use an ordinary MongoDB query or the local keyword fallback.
# MedGuard does not invent an embedding endpoint and does not pretend vector search ran.
MONGODB_VECTOR_INDEX=
EMBEDDING_URL=

# Set to 1 to finish verification inside the HTTP request (used by tests).
MEDGUARD_SYNC=0
